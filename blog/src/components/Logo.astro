---
/** Marca estoque.autos — espelho do src/components/Logo.tsx do produto. */
interface Props {
  size?: number;
  showWordmark?: boolean;
  /** Acrescenta "/blog" após o wordmark. */
  blog?: boolean;
}
const { size = 22, showWordmark = true, blog = false } = Astro.props;
const BRAND = "#ff7a1a";
---

<span
  class="logo"
  style={`gap:${Math.round(size * 0.4)}px;font-size:${Math.round(size * 0.82)}px;`}
>
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    style="display:block;flex-shrink:0"
  >
    <rect width="32" height="32" rx="8" fill={BRAND}></rect>
    <path
      d="M9.5 10 15 16l-5.5 6M16 10l5.5 6L16 22"
      stroke="#160a02"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  {
    showWordmark && (
      <span>
        estoque<span style={`color:${BRAND}`}>.autos</span>
        {blog && <span class="logo-blog">/blog</span>}
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo-blog {
    font-weight: 500;
    color: var(--muted-foreground);
  }
</style>
